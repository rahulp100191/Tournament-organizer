{
  "name": "rally-tournaments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-api.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/platform.test.ts",
    "typecheck": "tsc --noEmit",
    "dev:api": "tsx --env-file-if-exists=.env server/local.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
    "android:generate": "node scripts/android-generate.mjs",
    "test:browser": "tsx tests/browser.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.1",
    "express": "^5.3.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.27.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "esbuild": "^0.25.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}